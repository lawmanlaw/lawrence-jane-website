# Send everyone to https://lawrencejane.com (old rf.gd address, www and http all redirect)
RewriteEngine On
RewriteCond %{HTTP_HOST} !^lawrencejane\.com$ [NC]
RewriteRule ^(.*)$ https://lawrencejane.com/$1 [L,R=301]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://lawrencejane.com/$1 [L,R=301]

# Faster loading: compress text files and let browsers cache images
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
